{
  "name": "claim-processing-system",
  "version": "0.1.0",
  "private": true,
  "description": "Insurance claims adjudication system — fixed pipeline, append-only ledger, derived claim state.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "test": "mocha \"test/**/*.test.ts\"",
    "test:unit": "mocha \"test/unit/**/*.test.ts\"",
    "test:integration": "mocha --no-config --require ts-node/register \"test/integration/**/*.test.ts\"",
    "test:e2e": "mocha --no-config --require ts-node/register \"test/e2e/**/*.test.ts\"",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chai": "^4.3.16",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/sinon": "^17.0.3",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "prisma": "^5.18.0",
    "sinon": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
