# Prisma datasource (SQLite). Local dev database file.
DATABASE_URL="file:./dev.db"

# Separate database for integration/e2e isolation.
TEST_DATABASE_URL="file:./test.db"

# Express HTTP port.
PORT=3000

# Coverage-rule config consumed by the strict rule loader.
POLICY_CONFIG_PATH="./policies/standard-plan-2026.json"

# Single-currency assumption (domain-model §10.1).
CURRENCY="USD"
